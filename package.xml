<?xml version="1.0"?>
<package>
  <name>fast_lio</name>
  <version>0.1.0</version>

  <description>
    FAST-LIO2 adaptation for Hesai JT-series and MT60 LiDARs on ROS 1.
    Publishes LiDAR-inertial odometry, registered point clouds, and optional
    PCD maps from standard PointCloud2 and Imu input topics.
  </description>

  <maintainer email="opensource@hesaitech.com">Hesai Technology</maintainer>

  <license>GPL-2.0</license>

  <author email="zhangji@cmu.edu">Ji Zhang</author>
  <author>FAST-LIO contributors</author>
  <author email="opensource@hesaitech.com">Hesai Technology</author>
  
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>message_generation</build_depend>

  <run_depend>geometry_msgs</run_depend>
  <run_depend>nav_msgs</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>rospy</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>std_srvs</run_depend>
  <run_depend>tf</run_depend>
  <run_depend>pcl_ros</run_depend>
  <run_depend>hesai_ros_driver</run_depend>
  <run_depend>message_runtime</run_depend>
  <run_depend>python3-numpy</run_depend>
  <run_depend>python3-yaml</run_depend>
  <run_depend>rosbag</run_depend>
  <run_depend>roslaunch</run_depend>
  <run_depend>rviz</run_depend>

  <test_depend>rostest</test_depend>

  <export>
  </export>
</package>
