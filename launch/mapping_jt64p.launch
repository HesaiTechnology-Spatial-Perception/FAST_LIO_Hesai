<launch>
    <arg name="rviz" default="true" />
    <arg name="config_file" default="$(find fast_lio)/config/jt64p.yaml" />
    <rosparam command="load" file="$(arg config_file)" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />
    <group if="$(arg rviz)"><node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" /></group>
</launch>
